# Образец переменных окружения боевого сервера.
#
# Скопировать в /etc/erekshe/erekshe.env, подставить свои значения и
# закрыть от посторонних:
#
#   sudo install -d -m 700 /etc/erekshe
#   sudo cp deploy/erekshe.env.example /etc/erekshe/erekshe.env
#   sudo chown root:erekshe /etc/erekshe/erekshe.env
#   sudo chmod 640 /etc/erekshe/erekshe.env
#
# Этот файл - образец, в нём не должно быть настоящих паролей и ключей.

# --- Админка -----------------------------------------------------------
# Логина и пароля по умолчанию нет: пока обе переменные пусты, вход в
# /admin отключён. Пароль придумайте длинный: он защищает персональные
# данные заявителей.
ADMIN_LOGIN=смените-меня
ADMIN_PASSWORD=смените-меня

# --- Ключи -------------------------------------------------------------
# Подпись cookie администратора. Задать один раз и не менять: после смены
# все входы сбрасываются. Сгенерировать: openssl rand -hex 32
SECRET_KEY=смените-меня

# Соль для хеширования адресов посетителей. Если потерять, перестанут
# совпадать старые хеши, и ограничения «три заявки в час» и «один отзыв
# в сутки» начнут считать заново. Сгенерировать: openssl rand -hex 32
IP_SALT=смените-меня

# --- Где лежат данные --------------------------------------------------
DB_PATH=/srv/erekshe/data/catalog.db
UPLOAD_DIR=/srv/erekshe/data/uploads

# --- Боевые настройки --------------------------------------------------
# Адрес сайта: подставляется в sitemap.xml, canonical и Open Graph.
SITE_URL=https://erekshe.kz

# Cookie админки уходит только по HTTPS. Включать после того, как
# сертификат получен и сайт открывается по https.
COOKIE_SECURE=1

# Настоящий адрес посетителя берётся из X-Forwarded-For. Включать только
# когда до приложения нельзя достучаться мимо nginx: оно слушает
# 127.0.0.1, значит можно.
TRUST_PROXY_HEADERS=1

# --- Чего здесь быть не должно ----------------------------------------
# SEED_DEMO - наливает в пустую базу демонстрационные записи и отзывы.
# NOINDEX - закрывает сайт от поисковиков.
# SHOW_TEST_BANNER - рисует полосу «Тестовая версия сайта».
# На боевом сервере все три не задаются. Строки ниже оставлены
# закомментированными, чтобы было видно, что их не забыли, а убрали.
# SEED_DEMO=1
# NOINDEX=1
# SHOW_TEST_BANNER=1
