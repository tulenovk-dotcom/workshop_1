[Unit]
# Расписание обновления справочника местоположений. Нужно, только если
# фоновое обновление в самом сайте выключено (GEOIP_AUTO_UPDATE=0).
#
# Проверка раз в неделю, а не раз в месяц: справочник обновляется раз в
# месяц, но если в нужный день не вышло (нет сети, сайт DB-IP недоступен),
# следующая попытка будет через неделю, а не через месяц. Когда файл уже
# свежий, проверка занимает секунду и ничего не качает.
Description=Еженедельная проверка справочника местоположений (erekshe.kz)

[Timer]
# По понедельникам ночью по времени Казахстана.
OnCalendar=Mon *-*-* 03:20:00 Asia/Almaty
# Если сервер в это время был выключен - запустить после включения.
Persistent=true
RandomizedDelaySec=20m

[Install]
WantedBy=timers.target
